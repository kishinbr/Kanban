<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - KanbanApp</title>

    <script type="importmap"></script>

    <link rel="stylesheet"href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"href="~/css/site.css"asp-append-version="true" />

    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />

</head>

<body class="m-0 bg-dark text-light">

    <header>
        <nav class="navbar navbar-expand-sm navbar-dark navbar-kanban shadow-sm mb-3">

            <div class="container-fluid px-4">

                <!-- Logo -->
                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    KanbanApp
                </a>


                <!-- Botão mobile -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarPrincipal"
                        aria-controls="navbarPrincipal"
                        aria-expanded="false"
                        aria-label="Abrir menu">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- Menu -->
                <div class="collapse navbar-collapse"
                     id="navbarPrincipal">

                    <!-- Links da esquerda -->
                    <ul class="navbar-nav">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Painel"
                                   asp-action="Index">
                                    Painel
                                </a>
                            </li>
                        }

                    </ul>


                    <!-- Login / Sair no canto direito -->
                    <ul class="navbar-nav ms-auto">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">

                                <a class="nav-link nav-link-sair"
                                   asp-area=""
                                   asp-controller="Conta"
                                   asp-action="Logout">
                                    
                                    Deslogar
                                </a>

                            </li>
                        }
                        else
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Conta"
                                   asp-action="Login">
                                    Login
                                </a>

                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>
    </header>


    <div class="container-fluid">

        <main role="main">
            @RenderBody()
        </main>

    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>


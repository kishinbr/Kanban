@{
    ViewData["Title"] = "Login";
}

<div class="login-container">

    <div class="card login-card shadow-lg rounded-3">

        <!-- Cabeçalho -->
        <div class="card-header bg-dark border-secondary text-center p-4">

            <h2 class="login-titulo mb-1">
                Entrar
            </h2>

            <p class="text-secondary mb-0">
                Acesse sua conta no KanbanApp
            </p>

        </div>


        <!-- Corpo -->
        <div class="card-body p-4">

            <!-- Erros -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" role="alert">

                    <strong>Não foi possível entrar.</strong>

                    @foreach (var erro in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>
                            @erro.ErrorMessage
                        </div>
                    }

                </div>
            }


            <!-- Formulário -->
            <form method="post" action="/Conta/Login">

                <!-- Email -->
                <div class="mb-3">

                    <label for="email"
                           class="form-label text-light">
                        Email
                    </label>

                    <input type="email"
                           id="email"
                           name="email"
                           class="form-control login-input"
                           placeholder="Digite seu email"
                           autocomplete="email"
                           required />

                </div>


                <!-- Senha -->
                <div class="mb-4">

                    <label for="senha"
                           class="form-label text-light">
                        Senha
                    </label>

                    <input type="password"
                           id="senha"
                           name="senha"
                           class="form-control login-input"
                           placeholder="Digite sua senha"
                           autocomplete="current-password"
                           required />

                </div>


                <!-- Botão -->
                <button type="submit"
                        class="btn btn-primary w-100">
                    Entrar
                </button>

            </form>

        </div>


        <!-- Rodapé -->
        <div class="card-footer bg-dark border-secondary text-center p-3">

            <span class="text-secondary">
                Não tem uma conta?
            </span>

            <a href="/Conta/Cadastro"
               class="login-cadastro ms-1">
                Cadastre-se
            </a>

        </div>

    </div>

</div>


@model IEnumerable<KanbanApp.Models.Quadro>

@{
    ViewData["Title"] = "Meu Painel";
}

<!-- Container Principal -->
<div class="painel-container text-light p-4 rounded-3 shadow-lg w-100">

    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary">

        <div>
            <h2 class="fw-bold text-info mb-1">
                Olá, @User.Identity!.Name!
            </h2>

            <p class="text-secondary mb-0 fs-5">
                Selecione um Kanban, crie um novo ou participe de um existente para continuar.
            </p>
        </div>

        <a href="/Conta/Logout"
           class="btn btn-outline-danger">
            Deslogar
        </a>

    </div>


    <!-- Mensagem de erro -->
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger border-danger mb-4">
            @TempData["Erro"]
        </div>
    }
    <!-- Área de ações -->
    <div class="row g-3 mt-4 mb-4">

        <!-- Criar -->
        <div class="col-12 col-lg-6">

            <div class="area-acao rounded-3 p-4 h-100">

                <h4 class="text-info fw-bold mb-2">
                    Criar um novo Kanban
                </h4>

                <p class="text-secondary mb-4">
                    Crie seu próprio quadro e comece a organizar suas tarefas.
                </p>

                <a href="/Quadro/Criar"
                   class="btn btn-primary">
                    + Criar novo Kanban
                </a>

            </div>

        </div>


        <!-- Entrar -->
        <div class="col-12 col-lg-6">

            <div class="area-acao rounded-3 p-4 h-100">

                <h4 class="text-info fw-bold mb-2">
                    Entrar em um Kanban
                </h4>

                <p class="text-secondary mb-3">
                    Possui um código de compartilhamento? Digite abaixo para entrar.
                </p>

                <form method="post"
                      action="/Quadro/Entrar">

                    <div class="input-group">

                        <input type="text"
                               name="codigo"
                               class="form-control bg-dark text-light border-secondary"
                               placeholder="Digite o código..."
                               required />

                        <button type="submit"
                                class="btn btn-outline-info">
                            Entrar
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

    <!-- Meus Kanbans -->
    <div class="mb-4">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <h3 class="text-info fw-bold mb-0">
                Meus Kanbans
            </h3>

            <span class="badge bg-secondary fs-6">
                @Model.Count() @(Model.Count() == 1 ? "Kanban" : "Kanbans")
            </span>

        </div>


        @if (!Model.Any())
        {
            <!-- Nenhum Kanban -->
            <div class="area-acao rounded-3 p-5 text-center">

                <div class="fs-1 mb-3">
                    📋
                </div>

                <h4 class="text-light">
                    Você ainda não participa de nenhum Kanban
                </h4>

                <p class="text-secondary mb-4">
                    Crie um novo Kanban ou entre em um existente usando um código.
                </p>

                <a href="/Quadro/Criar"
                   class="btn btn-primary">
                    + Criar novo Kanban
                </a>

            </div>
        }
        else
        {
            <!-- Cards dos Kanbans -->
            <div class="row g-3">

                @foreach (var quadro in Model)
                {
                    <div class="col-12 col-md-6 col-xl-4">

                        <div class="kanban-card rounded-3 h-100">

                            <div class="card-body p-4 d-flex flex-column">

                                <!-- Nome -->
                                <div class="d-flex justify-content-between align-items-start mb-3">

                                    <h4 class="nome-kanban mb-0">
                                        @quadro.Nome
                                    </h4>

                                    @if (quadro.Papel == "dono")
                                    {
                                        <span class="badge bg-success">
                                            Dono
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Espectador
                                        </span>
                                    }

                                </div>


                                <!-- Código -->
                                <div class="mb-4">

                                    <small class="text-secondary d-block mb-1">
                                        Clique para acessar seu Kanban:
                                    </small>

                                    

                                </div>


                                <!-- Abrir -->
                                <div class="mt-auto">

                                    <a href="/Quadro/Ver/@quadro.Id"
                                       class="btn btn-outline-info w-100">
                                        Abrir Kanban →
                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>


    

</div>


@model KanbanApp.ViewModels.QuadroDetalheViewModel

@{
    ViewData["Title"] = Model.Quadro.Nome;
    bool ehDono = Model.Papel == "dono";
}

<h2>@Model.Quadro.Nome</h2>
<p>
    Código: <strong>@Model.Quadro.CodigoCompartilhamento</strong>
    — Você é: <strong>@(ehDono ? "Dono" : "Espectador")</strong>
</p>
<p><a href="/Painel/Index">Voltar ao Painel</a></p>

@if (!ehDono)
{
    <form method="post" action="/Quadro/Sair" style="display: inline;"
          onsubmit="return confirm('Tem certeza que deseja sair deste kanban? Você vai perder o acesso a ele.');">
        <input type="hidden" name="quadroId" value="@Model.Quadro.Id" />
        <button type="submit">Sair do Kanban</button>
    </form>
}

<hr />

@if (ehDono)
{
    <form method="post" action="/Quadro/CriarColuna" style="margin-bottom: 20px;">
        <input type="hidden" name="quadroId" value="@Model.Quadro.Id" />
        <label>Nova coluna:</label>
        <input type="text" name="nome" required />
        <button type="submit">Adicionar Coluna</button>
    </form>
}

<div style="display: flex; gap: 20px;">
    @foreach (var colunaComCartoes in Model.Colunas)
    {
        <div style="border: 1px solid #ccc; padding: 10px; min-width: 250px;"
             id="coluna-@colunaComCartoes.Coluna.Id"
             ondragover="@(ehDono ? "permitirSoltar(event)" : "")"
             ondrop="@(ehDono ? $"soltarCartao(event, {colunaComCartoes.Coluna.Id})" : "")">
            <h4>
                @if (ehDono)
                {
                    <form method="post" action="/Quadro/EditarColuna" id="formColuna@(colunaComCartoes.Coluna.Id)" style="display:inline;">
                        <input type="hidden" name="id" value="@colunaComCartoes.Coluna.Id" />
                        <input type="hidden" name="quadroId" value="@Model.Quadro.Id" />
                        <input type="text" name="nome" value="@colunaComCartoes.Coluna.Nome"
                               onblur="document.getElementById('formColuna@(colunaComCartoes.Coluna.Id)').submit();"
                               onkeydown="if(event.key==='Enter'){ event.preventDefault(); this.blur(); }"
                               style="border:none; background:transparent; font-weight:bold; font-size:1em; width:150px;" />
                    </form>

                    <form method="post" action="/Quadro/ExcluirColuna" style="display: inline;"
                          onsubmit="return confirm('Tem certeza que deseja excluir esta coluna e todos os cartões dela?');">
                        <input type="hidden" name="colunaId" value="@colunaComCartoes.Coluna.Id" />
                        <button type="submit" style="font-size: 0.7em;">🗑️</button>
                    </form>
                }
                else
                {
                    @colunaComCartoes.Coluna.Nome
                }
            </h4>

            @foreach (var cartao in colunaComCartoes.Cartoes)
            {
                <div style="background: #f0f0f0; padding: 8px; margin-bottom: 8px; border-radius: 4px;"
                     id="cartao-@cartao.Id"
                     draggable="@(ehDono ? "true" : "false")"
                     ondragstart="@(ehDono ? $"arrastarCartao(event, {cartao.Id})" : "")">
                    <strong>@cartao.Titulo</strong>
                    @if (!string.IsNullOrEmpty(cartao.Descricao))
                    {
                        <p style="font-size: 0.9em;">@cartao.Descricao</p>
                    }
                    @if (ehDono)
                    {
                        <a href="#" class="btn-editar-cartao" style="font-size: 0.7em;"
                           data-id="@cartao.Id"
                           data-titulo="@cartao.Titulo"
                           data-descricao="@cartao.Descricao"
                           onclick="abrirModalEdicao(this); return false;">✏️</a>
                        <form method="post" action="/Quadro/ExcluirCartao" style="display: inline;"
                              onsubmit="return confirm('Tem certeza que deseja excluir este cartão?');">
                            <input type="hidden" name="cartaoId" value="@cartao.Id" />
                            <input type="hidden" name="quadroId" value="@Model.Quadro.Id" />
                            <button type="submit" style="font-size: 0.7em;">🗑️</button>
                        </form>
                    }
                </div>
            }

            @if (ehDono)
            {
                <form method="post" action="/Quadro/CriarCartao">
                    <input type="hidden" name="colunaId" value="@colunaComCartoes.Coluna.Id" />
                    <input type="text" name="titulo" placeholder="Título do cartão" required />
                    <button type="submit">+ Cartão</button>
                </form>
            }
        </div>
    }
</div>

<div id="modalEdicao" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); align-items:center; justify-content:center;">
    <div style="background:white; padding:20px; border-radius:8px; width:400px;">
        <h3>Editar Cartão</h3>
        <form method="post" action="/Quadro/EditarCartao">
            <input type="hidden" name="id" id="modalCartaoId" />
            <input type="hidden" name="quadroId" value="@Model.Quadro.Id" />

            <div>
                <label>Título:</label>
                <input type="text" name="titulo" id="modalTitulo" required style="width:100%;" />
            </div>
            <div style="margin-top:10px;">
                <label>Descrição:</label>
                <textarea name="descricao" id="modalDescricao" style="width:100%;"></textarea>
            </div>
            <div style="margin-top:15px;">
                <button type="submit">Salvar</button>
                <button type="button" onclick="fecharModalEdicao()">Cancelar</button>
            </div>
        </form>
    </div>
</div>

<script>
    function abrirModalEdicao(link) {
        document.getElementById('modalCartaoId').value = link.dataset.id;
        document.getElementById('modalTitulo').value = link.dataset.titulo;
        document.getElementById('modalDescricao').value = link.dataset.descricao;
        document.getElementById('modalEdicao').style.display = 'flex';
    }

    function fecharModalEdicao() {
        document.getElementById('modalEdicao').style.display = 'none';
    }
    let cartaoArrastadoId = null;

    function arrastarCartao(event, cartaoId) {
        cartaoArrastadoId = cartaoId;
    }

    function permitirSoltar(event) {
        event.preventDefault();
    }

    async function soltarCartao(event, novaColunaId) {
        event.preventDefault();

        if (cartaoArrastadoId === null) return;

        const colunaDestino = document.getElementById('coluna-' + novaColunaId);
        const cartoesNaColuna = colunaDestino.querySelectorAll('[id^="cartao-"]');
        const novaOrdem = cartoesNaColuna.length;

        const resposta = await fetch(`/api/cartoes/${cartaoArrastadoId}/mover`, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                novaColunaId: novaColunaId,
                novaOrdem: novaOrdem
            })
        });

        if (resposta.ok) {
            location.reload();
        } else {
            alert('Erro ao mover o cartão.');
        }

        cartaoArrastadoId = null;
    }
</script>
@model KanbanApp.ViewModels.QuadroDetalheViewModel

@{
    ViewData["Title"] = Model.Quadro.Nome;
    bool ehDono = Model.Papel == "dono";
}

<!-- CSS local para esta View -->
<style>
    .container, .container-sm, .container-md, .container-lg, .container-xl, .container-xxl {
        max-width: 100% !important;
        padding-left: 1.5rem !important;
        padding-right: 1.5rem !important;
    }

    /* Aumenta levemente a fonte de toda a área do Kanban */
    .kanban-container {
        font-size: 1.05rem;
    }

    /* Mantém as colunas centralizadas */
    .kanban-colunas {
        display: flex;
        justify-content: center;
        gap: 1rem;
        width: fit-content;
        min-width: 100%;
        margin-left: auto;
        margin-right: auto;
    }

    /* Descrição mantém as quebras de linha digitadas */
    .descricao-cartao {
        white-space: pre-wrap;
        overflow-wrap: break-word;
        word-break: break-word;
    }
</style>

<!-- Container Principal com Tema Dark/Azul Escuro -->
<div class="kanban-container text-light p-4 rounded-3 shadow-lg w-100"
     style="background-color: #0d1b2a !important; min-height: 92vh;">

    <!-- Cabeçalho do Quadro -->
    <div class="d-flex justify-content-between align-items-center mb-4 p-3 border border-secondary border-2 rounded-3">

        <div>
            <h2 class="fw-bold text-info mb-2 fs-3">@Model.Quadro.Nome</h2>

            <p class="text-secondary mb-0 fs-5">
                Código:

                <span id="codigoCompartilhamento"
                      class="badge bg-primary text-wrap fs-6"
                      role="button"
                      title="Clique para mostrar o código"
                      onclick="alternarCodigo()">
                    ••••••••
                </span>

                <span id="codigoReal" class="d-none">
                    @Model.Quadro.CodigoCompartilhamento
                </span>

                — Função:

                <span class="badge @(ehDono ? "bg-success" : "bg-warning text-dark") fs-6">
                    @(ehDono ? "Dono" : "Espectador")
                </span>
            </p>


        </div>

        <div class="d-flex gap-2">
            <a href="/Painel/Index" class="btn btn-outline-info">
                <i class="bi bi-arrow-left"></i> Voltar ao Painel
            </a>

            @if (!ehDono)
            {
                <form method="post"
                      action="/Quadro/Sair"
                      class="d-inline"
                      onsubmit="return confirm('Tem certeza que deseja sair deste kanban? Você vai perder o acesso a ele.');">

                    <input type="hidden" name="quadroId" value="@Model.Quadro.Id" />

                    <button type="submit" class="btn btn-outline-danger">
                        Sair do Kanban
                    </button>
                </form>
            }
        </div>
    </div>

    <!-- Formulário para Criar Coluna -->
    @if (ehDono)
    {
        <div class="card bg-secondary bg-opacity-25 border-info border-opacity-25 mb-4">
            <div class="card-body p-3">

                <form method="post"
                      action="/Quadro/CriarColuna"
                      class="row g-2 align-items-center">

                    <input type="hidden"
                           name="quadroId"
                           value="@Model.Quadro.Id" />

                    <div class="col-auto">
                        <label class="col-form-label fw-semibold text-light fs-5">
                            Nova Coluna:
                        </label>
                    </div>

                    <div class="col-auto flex-grow-1">
                        <input type="text"
                               name="nome"
                               class="form-control bg-dark text-light border-secondary"
                               placeholder="Nome da coluna..."
                               required />
                    </div>

                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">
                            + Adicionar Coluna
                        </button>
                    </div>

                </form>
            </div>
        </div>
    }

    <!-- Área das Colunas -->
    <div class="overflow-auto pb-3 w-100"
         style="min-height: 600px;">

        <div class="kanban-colunas">

            @foreach (var colunaComCartoes in Model.Colunas)
            {
                <div class="card bg-secondary bg-opacity-10 border-secondary flex-shrink-0"
                     style="width: 300px; min-height: 560px;"
                     id="coluna-@colunaComCartoes.Coluna.Id"
                     ondragover="@(ehDono ? "permitirSoltar(event)" : "")"
                     ondrop="@(ehDono ? $"soltarCartao(event, {colunaComCartoes.Coluna.Id})" : "")">

                    <!-- Cabeçalho da Coluna -->
                    <div class="card-header bg-dark bg-opacity-50 border-bottom border-secondary d-flex justify-content-between align-items-center">

                        @if (ehDono)
                        {
                            <form method="post"
                                  action="/Quadro/EditarColuna"
                                  id="formColuna@(colunaComCartoes.Coluna.Id)"
                                  class="d-inline flex-grow-1 me-2">

                                <input type="hidden"
                                       name="id"
                                       value="@colunaComCartoes.Coluna.Id" />

                                <input type="hidden"
                                       name="quadroId"
                                       value="@Model.Quadro.Id" />

                                <input type="text"
                                       name="nome"
                                       value="@colunaComCartoes.Coluna.Nome"
                                       onblur="document.getElementById('formColuna@(colunaComCartoes.Coluna.Id)').submit();"
                                       onkeydown="if(event.key==='Enter'){ event.preventDefault(); this.blur(); }"
                                       class="form-control form-control-sm bg-transparent border-0 text-light fw-bold fs-5 p-0" />
                            </form>

                            <form method="post"
                                  action="/Quadro/ExcluirColuna"
                                  class="d-inline"
                                  onsubmit="return confirm('Tem certeza que deseja excluir esta coluna e todos os cartões dela?');">

                                <input type="hidden"
                                       name="colunaId"
                                       value="@colunaComCartoes.Coluna.Id" />

                                <button type="submit"
                                        class="btn btn-link text-danger p-0 text-decoration-none fs-5">
                                    🗑️
                                </button>
                            </form>
                        }
                        else
                        {
                            <h6 class="mb-0 fw-bold text-info fs-5">
                                @colunaComCartoes.Coluna.Nome
                            </h6>
                        }

                    </div>

                    <!-- Lista de Cartões -->
                    <div class="card-body p-2 overflow-auto"
                         style="max-height: 500px;">

                        @foreach (var cartao in colunaComCartoes.Cartoes)
                        {
                            <div class="card bg-dark text-light border-secondary mb-2 shadow-sm"
                                 id="cartao-@cartao.Id"
                                 draggable="@(ehDono ? "true" : "false")"
                                 ondragstart="@(ehDono ? $"arrastarCartao(event, {cartao.Id})" : "")">

                                <div class="card-body p-3">

                                    <div class="d-flex justify-content-between align-items-start">

                                        <h6 class="card-title text-light mb-1 fw-bold fs-5">
                                            @cartao.Titulo
                                        </h6>

                                        @if (ehDono)
                                        {
                                            <div class="d-flex gap-1 ms-2">

                                                <a href="#"
                                                   class="btn-editar-cartao text-decoration-none"
                                                   data-id="@cartao.Id"
                                                   data-titulo="@cartao.Titulo"
                                                   data-descricao="@cartao.Descricao"
                                                   onclick="abrirModalEdicao(this); return false;">
                                                    ✏️
                                                </a>

                                                <form method="post"
                                                      action="/Quadro/ExcluirCartao"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Tem certeza que deseja excluir este cartão?');">

                                                    <input type="hidden"
                                                           name="cartaoId"
                                                           value="@cartao.Id" />

                                                    <input type="hidden"
                                                           name="quadroId"
                                                           value="@Model.Quadro.Id" />

                                                    <button type="submit"
                                                            class="btn btn-link p-0 text-decoration-none">
                                                        🗑️
                                                    </button>
                                                </form>

                                            </div>
                                        }

                                    </div>

                                    @if (!string.IsNullOrEmpty(cartao.Descricao))
                                    {
                                        <p class="card-text text-secondary small mb-0 mt-2 descricao-cartao">@Html.Raw(cartao.Descricao.Replace("\r\n", "<br>").Replace("\n", "<br>"))</p>
                                    }

                                </div>
                            </div>
                        }

                    </div>

                    <!-- Adicionar Cartão -->
                    @if (ehDono)
                    {
                        <div class="card-footer bg-transparent border-top-0 p-2">

                            <form method="post"
                                  action="/Quadro/CriarCartao">

                                <input type="hidden"
                                       name="colunaId"
                                       value="@colunaComCartoes.Coluna.Id" />

                                <div class="input-group input-group-sm">

                                    <input type="text"
                                           name="titulo"
                                           class="form-control bg-dark text-light border-secondary"
                                           placeholder="Novo cartão..."
                                           required />

                                    <button type="submit"
                                            class="btn btn-outline-info">
                                        +
                                    </button>

                                </div>
                            </form>

                        </div>
                    }

                </div>
            }

        </div>
    </div>
</div>

<!-- Modal -->
<div id="modalEdicao"
     style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.7); align-items:center; justify-content:center; z-index:1050;">

    <div class="card bg-dark text-light border-secondary shadow-lg"
         style="width: 400px;">

        <div class="card-header border-secondary">
            <h5 class="card-title text-info mb-0">
                Editar Cartão
            </h5>
        </div>

        <div class="card-body">

            <form method="post"
                  action="/Quadro/EditarCartao">

                <input type="hidden"
                       name="id"
                       id="modalCartaoId" />

                <input type="hidden"
                       name="quadroId"
                       value="@Model.Quadro.Id" />

                <div class="mb-3">
                    <label class="form-label text-secondary">
                        Título:
                    </label>

                    <input type="text"
                           name="titulo"
                           id="modalTitulo"
                           class="form-control bg-secondary bg-opacity-25 text-light border-secondary"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label text-secondary">
                        Descrição:
                    </label>

                    <textarea name="descricao"
                              id="modalDescricao"
                              class="form-control bg-secondary bg-opacity-25 text-light border-secondary"
                              rows="3"></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-3">

                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            onclick="fecharModalEdicao()">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-primary btn-sm">
                        Salvar
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

<script>
    function abrirModalEdicao(link) {
        document.getElementById('modalCartaoId').value = link.dataset.id;
        document.getElementById('modalTitulo').value = link.dataset.titulo;
        document.getElementById('modalDescricao').value = link.dataset.descricao;
        document.getElementById('modalEdicao').style.display = 'flex';
    }

    function fecharModalEdicao() {
        document.getElementById('modalEdicao').style.display = 'none';
    }

    let cartaoArrastadoId = null;

    function arrastarCartao(event, cartaoId) {
        cartaoArrastadoId = cartaoId;
    }

    function permitirSoltar(event) {
        event.preventDefault();
    }

    async function soltarCartao(event, novaColunaId) {
        event.preventDefault();

        if (cartaoArrastadoId === null) return;

        const colunaDestino = document.getElementById('coluna-' + novaColunaId);
        const cartoesNaColuna = colunaDestino.querySelectorAll('[id^="cartao-"]');
        const novaOrdem = cartoesNaColuna.length;

        const resposta = await fetch(`/api/cartoes/${cartaoArrastadoId}/mover`, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                novaColunaId: novaColunaId,
                novaOrdem: novaOrdem
            })
        });

        if (resposta.ok) {
            location.reload();
        } else {
            alert('Erro ao mover o cartão.');
        }

        cartaoArrastadoId = null;
    }

    function alternarCodigo() {
        const codigo = document.getElementById('codigoCompartilhamento');
        const codigoReal = document.getElementById('codigoReal');

        if (codigo.dataset.mostrando === 'true') {
            codigo.textContent = '••••••••';
            codigo.dataset.mostrando = 'false';
            codigo.title = 'Clique para mostrar o código';
        } else {
            codigo.textContent = codigoReal.textContent.trim();
            codigo.dataset.mostrando = 'true';
            codigo.title = 'Clique para esconder o código';
        }
    }


</script>

